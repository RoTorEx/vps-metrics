[Unit]
Description=Collect host metrics in an isolated Docker container
Requires=docker.service
After=docker.service
RequiresMountsFor=/srv/host-metrics

[Service]
Type=oneshot
WorkingDirectory=/srv/host-metrics
Environment=DOCKER_CONFIG=/run/host-metrics
RuntimeDirectory=host-metrics
ExecStartPre=-/usr/bin/docker rm -f host-metrics
ExecStart=/usr/bin/docker compose --env-file /srv/host-metrics/config/collector.env run --rm --no-deps --name host-metrics metrics
ExecStopPost=-/usr/bin/docker rm -f host-metrics
UMask=0022
TimeoutStartSec=30
MemoryMax=128M
TasksMax=64
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
